# Copy to .env and fill these values only after the project owner provides
# authorized connection details. Never commit .env or paste secrets into chat.

# Express server
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL connection (the backend's existing pg client reads DATABASE_URL)
# Add the Supabase Postgres connection string when it is provided.
DATABASE_URL=
DB_SSL=true

# Existing Google sign-in
GOOGLE_CLIENT_ID=
ALLOW_DEV_LOGIN=false

# Reserved for a possible Supabase Auth integration; current code does not read these.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
