            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"dev:chidinma@test.com\",\n  \"role\": \"HOUSEHOLD\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set(\"tokenH\", j.token);"
                ]
              }
            }
